<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Energía eléctrica · Los Maitenes</title>
<style>
  :root { --fondo:#F4F3EF; --blanco:#FFFFFF; --negro:#1A1A1A; --acero:#6B7280; --borde:#E5E2DA; --verde:#2D7D46; --amarillo:#F5A623; --rojo:#B91C1C; --azul:#2563EB; --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  @media (prefers-color-scheme: dark) { :root { --fondo:#141414; --blanco:#1F1F1F; --negro:#F3F4F6; --acero:#9CA3AF; --borde:#33332F; } header { background:#000 !important; color:#fff !important; } thead tr { background:#2A2A2A !important; color:#fff !important; } .btn-secondary { background:#2E2E2E !important; color:#F3F4F6 !important; } select, input, textarea { background:#262626 !important; color:#F3F4F6 !important; } }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--fondo); color: var(--negro); font-family: var(--sans); }
  header { background: #1A1A1A; color: #fff; padding: 12px 16px; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  header h1 { margin: 0; font-size: 17px; flex:1; }
  header span { font-size: 12px; color: #D1D5DB; }
