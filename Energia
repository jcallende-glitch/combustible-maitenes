  nav button { flex:1 0 auto; padding:10px 12px; border:1px solid var(--borde); background:var(--blanco); color:var(--negro); border-radius:10px 10px 0 0; font-size:14px; font-weight:600; cursor:pointer; font-family:var(--sans); white-space:nowrap; }
  nav button.on { background:var(--amarillo); color:#111; border-color:var(--amarillo); }
