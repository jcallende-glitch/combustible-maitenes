  .chip.ok { background:#DCFCE7; color:#166534; } .chip.warn { background:#FEF3C7; color:#92400E; } .chip.err { background:#FEE2E2; color:#991B1B; } .chip.info { background:#DBEAFE; color:#1E40AF; }
  .chk { font-size:13px; padding:6px 8px; border-radius:8px; margin-bottom:4px; display:flex; gap:6px; }
  .chk.ok { background:#F0FDF4; color:#166534; } .chk.warn { background:#FFFBEB; color:#92400E; } .chk.err { background:#FEF2F2; color:#991B1B; } .chk.info { background:#EFF6FF; color:#1E40AF; }
  @media (prefers-color-scheme: dark) { .chk.ok { background:#052E16; color:#86EFAC; } .chk.warn { background:#3B2A05; color:#FCD34D; } .chk.err { background:#450A0A; color:#FCA5A5; } .chk.info { background:#0B1E3F; color:#93C5FD; } }
  .kpi { display:grid; grid-template-columns: repeat(auto-fit, minmax(130px,1fr)); gap:8px; margin:8px 0; }
  .kpi div { background: var(--fondo); border-radius:8px; padding:8px 10px; }
  .kpi b { display:block; font-size:18px; } .kpi small { color: var(--acero); font-size:11px; text-transform:uppercase; letter-spacing:.04em; }
  .up { color:#B91C1C; } .down { color:#15803D; }
  #toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); background: #1A1A1A; color: #fff; padding: 10px 16px; border-radius: 8px; font-size: 14px; display: none; z-index: 5000; max-width: 90vw; }
  #toast.mal { background: #B91C1C; }
