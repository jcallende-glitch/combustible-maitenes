  }).join('');
  const meses = [...new Set(S.fac.map(f => f.mes).filter(Boolean))].sort().slice(-12);
  const act = S.sum.filter(s => s.activo !== false);
  const filaM = (m) => { const fs = S.fac.filter(f => f.mes === m); return `<tr><td>${mesTxt(m)}</td>${act.map(s => { const f = fs.find(x => x.suministro === s.id); return `<td class="n">${f ? num(f.consumoKwh) : '–'}</td><td class="n">${f ? pesos(f.total) : '–'}</td>`; }).join('')}<td class="n"><b>${num(fs.reduce((a, f) => a + (f.consumoKwh || 0), 0))}</b></td><td class="n"><b>${pesos(fs.reduce((a, f) => a + (f.total || 0), 0))}</b></td></tr>`; };
  const tabla = meses.length ? `<div class="panel"><h2>Todos los suministros por mes</h2><div class="tw"><table><thead><tr><th>Mes</th>${act.map(s => `<th class="n" colspan="2">${escA(s.nombre)}</th>`).join('')}<th class="n" colspan="2">Total</th></tr><tr style="background:#333"><th></th>${act.map(() => '<th class="n">kWh</th><th class="n">$</th>').join('')}<th class="n">kWh</th><th class="n">$</th></tr></thead><tbody>${[...meses].reverse().map(filaM).join('')}</tbody></table></div></div>` : '';
  return tarjetas + tabla;
}

