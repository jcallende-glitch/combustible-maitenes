  .hint { font-size: 12px; color: var(--acero); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  thead tr { background: #1A1A1A; color: #fff; }
  thead th { padding: 8px 6px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; }
  tbody td { padding: 6px; border-bottom: 1px solid var(--borde); vertical-align: top; }
