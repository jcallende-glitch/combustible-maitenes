</style>
</head>
<body>
<div id="acceso">
  <div class="panel" style="width:100%;max-width:380px">
    <div style="font-weight:700;font-size:16px;margin-bottom:8px">⚡ Energía eléctrica</div>
    <div class="hint" style="margin-bottom:8px">Entra desde el menú de la app. Si tienes permiso, también puedes ingresar con tu PIN.</div>
    <div class="field"><label>Tu PIN</label><input type="password" id="acc-pin" inputmode="numeric" autocomplete="off" style="font-size:22px;text-align:center;letter-spacing:6px" onkeydown="if(event.key==='Enter')entrarEnergia()"></div>
    <div id="acc-msg" style="font-size:13px;color:#B91C1C;min-height:18px"></div>
    <button class="btn btn-verde btn-full" onclick="entrarEnergia()">Ingresar</button>
  </div>
</div>
<header><h1>⚡ Energía eléctrica</h1><span id="quien"></span><a href="/" style="color:#F5A623;font-size:13px">← Volver a la app</a></header>
<nav id="nav"></nav>
<main id="main"><div class="panel">Cargando…</div></main>
<div id="toast"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getFirestore, collection, doc, getDoc, getDocs, addDoc, setDoc, updateDoc, deleteDoc } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
const app = initializeApp({ apiKey: "AIzaSyAVsios3N97MQVPJLC94qEOXGJNmKzK9RI", authDomain: "combustible-los-maitenes.firebaseapp.com", projectId: "combustible-los-maitenes", storageBucket: "combustible-los-maitenes.firebasestorage.app", messagingSenderId: "750216939749", appId: "1:750216939749:web:978e4173eaee8235ebac0c" });
const db = getFirestore(app);

// ── utilidades ──────────────────────────────────────────────────────────
const $ = id => document.getElementById(id);
const escA = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const normNom = t => String(t || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
function toast(m, ok = true) { const t = $('toast'); t.textContent = m; t.className = ok ? '' : 'mal'; t.style.display = 'block'; clearTimeout(toast._t); toast._t = setTimeout(() => t.style.display = 'none', 4000); }
const pesos = v => v == null || !isFinite(v) ? '–' : (v < 0 ? '-$' : '$') + Math.abs(Math.round(v)).toLocaleString('es-CL');
const num = (v, d = 0) => v == null || !isFinite(v) ? '–' : Number(v).toLocaleString('es-CL', { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = v => v == null || !isFinite(v) ? '–' : (v > 0 ? '+' : '') + num(v, 1) + ' %';
const parseNum = v => { if (v == null) return null; let s = String(v).replace(/[$\s]/g, ''); if (!s || !/\d/.test(s)) return null; if (s.includes(',') && s.includes('.')) s = s.replace(/\./g, '').replace(',', '.'); else if (/^-?\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, ''); else s = s.replace(',', '.'); const n = parseFloat(s); return isFinite(n) ? n : null; };
const hoyStr = () => { const d = new Date(), p = n => String(n).padStart(2, '0'); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`; };
const ms = f => f ? new Date(f + 'T12:00:00').getTime() : null;
const dias = (a, b) => (ms(b) - ms(a)) / 86400000;
const fCorta = f => f ? f.slice(8, 10) + '-' + f.slice(5, 7) + '-' + f.slice(2, 4) : '–';
const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const mesTxt = m => m ? MESES[parseInt(m.slice(5, 7), 10) - 1] + ' ' + m.slice(2, 4) : '–';
const mesDe = f => f ? f.slice(0, 7) : '';
const mesMas = (m, n) => { let y = +m.slice(0, 4), k = +m.slice(5, 7) - 1 + n; y += Math.floor(k / 12); k = ((k % 12) + 12) % 12; return y + '-' + String(k + 1).padStart(2, '0'); };

// ── acceso ──────────────────────────────────────────────────────────────
const ADMINS_EQUIVALENTES = ['Camila Faundez', 'JC Allende'];
let USER = null, permisosPruebas = {};
const puedeVer = (n, admin) => admin || ADMINS_EQUIVALENTES.includes(n) || (Array.isArray(permisosPruebas[n]) && permisosPruebas[n].includes('energia'));
async function cargarPermisos() { try { const sn = await getDoc(doc(db, 'config', 'datos')); if (sn.exists()) permisosPruebas = sn.data().permisosPruebas || {}; } catch (e) {} }
window.entrarEnergia = async function () {
  const pin = $('acc-pin').value.trim(), msg = $('acc-msg'); if (!pin) { msg.textContent = 'Ingresa tu PIN.'; return; }
  let nombre = null;
  try { const sp = await getDoc(doc(db, 'config', 'pines')); const op = sp.exists() ? Object.entries(sp.data()).find(([, p]) => p === pin) : null; if (op) nombre = op[0]; }
  catch (e) { msg.textContent = 'No se pudo verificar: ' + e.message; return; }
  if (!nombre) { msg.textContent = 'PIN incorrecto. Si eres el administrador, entra desde el menú de la app.'; $('acc-pin').value = ''; return; }
  await cargarPermisos();
  if (!puedeVer(nombre, false)) { msg.textContent = 'No tienes acceso a Energía eléctrica.'; return; }
  USER = { nombre, admin: false, pin }; try { sessionStorage.setItem('energia_usuario', JSON.stringify({ nombre, admin: false })); } catch (e) {}
  $('acceso').style.display = 'none'; iniciar();
};
async function revisarAcceso() {
  await cargarPermisos();
  let u = null;
  try {
    let pase = JSON.parse(localStorage.getItem('maitenes_pase') || 'null');
    const hm = /[#&]pase=([^&]+)/.exec(location.hash || '');
    if (hm) { try { pase = JSON.parse(decodeURIComponent(hm[1])); } catch (e) {} try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {} }
    if (pase && pase.nombre && Date.now() - pase.ts < 10 * 60000) { u = { nombre: pase.nombre, admin: !!pase.admin }; localStorage.removeItem('maitenes_pase'); sessionStorage.setItem('energia_usuario', JSON.stringify(u)); }
    else u = JSON.parse(sessionStorage.getItem('energia_usuario') || 'null');
  } catch (e) {}
  if (u && puedeVer(u.nombre, u.admin)) { USER = u; iniciar(); return; }
  $('acceso').style.display = 'flex';
}

// ── datos ───────────────────────────────────────────────────────────────
const S = { sum: [], lec: [], fac: [], tab: 'resumen', form: null, filtroSum: '', cmp: { sum: '', met: 'kwh' } };
async function cargarTodo() {
  const leer = async n => (await getDocs(collection(db, n))).docs.map(d => ({ id: d.id, ...d.data() }));
  [S.sum, S.lec, S.fac] = await Promise.all([leer('energia_suministros'), leer('energia_lecturas'), leer('energia_facturas')]);
  S.sum.sort((a, b) => (a.nombre || '').localeCompare(b.nombre || '', 'es'));
}
const sumDe = id => S.sum.find(s => s.id === id);
const facDe = id => S.fac.filter(f => f.suministro === id).sort((a, b) => (a.periodoHasta || a.mes || '').localeCompare(b.periodoHasta || b.mes || ''));
const lecDe = id => S.lec.filter(l => l.suministro === id).sort((a, b) => a.fecha.localeCompare(b.fecha) || (a.ts || 0) - (b.ts || 0));
const precioKwh = f => { const base = f.neto || (f.total ? f.total / 1.19 : null); return base && f.consumoKwh > 0 ? base / f.consumoKwh : null; };

// Consumo según NUESTRAS lecturas entre dos fechas (interpolación lineal entre lecturas; tolera 4 días fuera del rango)
function valorEn(lecs, t) {
  if (!lecs.length) return null;
  const T = ms(t), first = lecs[0], last = lecs[lecs.length - 1];
  if (T < ms(first.fecha)) return dias(t, first.fecha) <= 4 ? { v: first.lectura, aprox: true } : null;
  if (T > ms(last.fecha)) return dias(last.fecha, t) <= 4 ? { v: last.lectura, aprox: true } : null;
  for (let i = 0; i < lecs.length; i++) {
    const a = lecs[i], b = lecs[i + 1];
    if (ms(a.fecha) === T) return { v: a.lectura, aprox: false };
    if (b && ms(a.fecha) < T && T <= ms(b.fecha)) { if (ms(b.fecha) === T) return { v: b.lectura, aprox: false }; if (b.reinicio) return null; const k = (T - ms(a.fecha)) / (ms(b.fecha) - ms(a.fecha)); return { v: a.lectura + (b.lectura - a.lectura) * k, aprox: ms(b.fecha) !== T && ms(a.fecha) !== T }; }
  }
  return null;
}
function consumoPropio(sumId, d0, d1) {
  const lecs = lecDe(sumId), s = sumDe(sumId), K = (s && s.constante) || 1;
  if (!d0 || !d1 || lecs.length < 2) return null;
  const a = valorEn(lecs, d0), b = valorEn(lecs, d1); if (!a || !b) return null;
  return { kwh: (b.v - a.v) * K, aprox: a.aprox || b.aprox };
}

// ── revisión automática de una factura ───────────────────────────────────
function revisarFactura(f, excluirId) {
  const out = [], add = (nivel, txt) => out.push({ nivel, txt });
  const s = sumDe(f.suministro);
  if (!s) add('err', 'Falta asignar la factura a un suministro.');
  const previas = facDe(f.suministro).filter(x => x.id !== excluirId);
  const hasta = f.periodoHasta || '', desde = f.periodoDesde || '';
  if (s && hasta && previas.some(x => x.periodoHasta === hasta || (x.mes && x.mes === mesDe(hasta)))) add('err', 'Ya existe una factura de este suministro para el mismo período (posible duplicado).');
  if (desde && hasta) { const d = dias(desde, hasta); if (d <= 0) add('err', 'El período termina antes de empezar.'); else if (d < 25 || d > 36) add('warn', `El período dura ${num(d)} días (lo normal es 28–33).`); else add('ok', `Período de ${num(d)} días.`); }
  else add('info', 'Faltan las fechas del período.');
  const K = f.constante || (s && s.constante) || 1;
  if (f.lecturaAnterior != null && f.lecturaActual != null && f.consumoKwh != null) {
    const calc = (f.lecturaActual - f.lecturaAnterior) * K, dif = f.consumoKwh - calc;
    if (Math.abs(dif) <= Math.max(1, calc * 0.01)) add('ok', `Lecturas × constante (${num(K, K % 1 ? 2 : 0)}) = ${num(calc)} kWh, coincide con el consumo facturado.`);
    else add('err', `Las lecturas dan ${num(calc)} kWh (${num(f.lecturaActual)} − ${num(f.lecturaAnterior)}, × ${num(K, K % 1 ? 2 : 0)}), pero se facturaron ${num(f.consumoKwh)} kWh (diferencia ${num(dif)}).`);
  } else add('info', 'Sin lecturas o consumo para cuadrar kWh.');
  const prev = previas.filter(x => (x.periodoHasta || '') < hasta).slice(-1)[0];
  if (prev && prev.lecturaActual != null && f.lecturaAnterior != null) {
    if (Math.abs(prev.lecturaActual - f.lecturaAnterior) > 1) add('warn', `La lectura anterior (${num(f.lecturaAnterior)}) no empalma con la actual de la factura previa (${num(prev.lecturaActual)}). Revisa si hubo cambio de medidor o una lectura estimada.`);
    else add('ok', 'La lectura anterior empalma con la factura previa.');
  }
  if (f.cargos && f.cargos.length && f.neto) {
    const sc = f.cargos.reduce((a, c) => a + (c.monto || 0), 0);
    if (Math.abs(sc - f.neto) > Math.max(5, f.neto * 0.01) && Math.abs(sc - (f.total || 0)) > Math.max(5, (f.total || 0) * 0.01)) add('warn', `Los cargos suman ${pesos(sc)}, pero la factura indica neto ${pesos(f.neto)} y total ${pesos(f.total)}.`);
    else add('ok', 'Los cargos suman lo que indica la factura.');
  }
  if (f.neto != null && f.iva != null && f.total != null) { if (Math.abs(f.neto + f.iva - f.total) > 5) add('warn', `Neto + IVA (${pesos(f.neto + f.iva)}) no coincide con el total (${pesos(f.total)}): puede haber saldos, multas o convenios.`); }
  if (f.neto != null && f.iva != null && f.neto > 0 && Math.abs(f.iva / f.neto - 0.19) > 0.01) add('warn', `El IVA es ${num(f.iva / f.neto * 100, 1)} % del neto (se espera 19 %).`);
  const precio = precioKwh(f), pp = previas.slice(-6).map(precioKwh).filter(Boolean);
  if (precio && pp.length >= 2) { const m = pp.reduce((a, b) => a + b, 0) / pp.length, v = (precio / m - 1) * 100; if (Math.abs(v) > 15) add('warn', `El precio medio es $${num(precio, 1)}/kWh, ${pct(v)} respecto del promedio de los últimos ${pp.length} meses ($${num(m, 1)}).`); else add('ok', `Precio medio $${num(precio, 1)}/kWh, normal (${pct(v)} vs el promedio).`); }
  else if (precio) add('info', `Precio medio $${num(precio, 1)}/kWh (aún no hay meses para comparar).`);
  const kw3 = previas.slice(-3).map(x => x.consumoKwh).filter(x => x != null);
  if (f.consumoKwh != null && kw3.length >= 2) { const m = kw3.reduce((a, b) => a + b, 0) / kw3.length, v = m > 0 ? (f.consumoKwh / m - 1) * 100 : null; if (v != null && Math.abs(v) > 30) add('warn', `El consumo (${num(f.consumoKwh)} kWh) es ${pct(v)} respecto del promedio de los últimos ${kw3.length} meses (${num(m)} kWh).`); else if (v != null) add('ok', `Consumo en lo normal (${pct(v)} vs los últimos ${kw3.length} meses).`); }
  const mp = hasta ? previas.find(x => x.mes === mesMas(mesDe(hasta), -12)) : null;
  if (mp && mp.consumoKwh && f.consumoKwh != null) { const v = (f.consumoKwh / mp.consumoKwh - 1) * 100; add(Math.abs(v) > 25 ? 'info' : 'ok', `Contra el mismo mes del año anterior (${num(mp.consumoKwh)} kWh): ${pct(v)}.`); }
  if (f.demandaMaxKw != null && f.potenciaKw != null && f.demandaMaxKw > f.potenciaKw * 1.02) add('warn', `La demanda máxima (${num(f.demandaMaxKw, 1)} kW) supera la potencia conectada (${num(f.potenciaKw, 1)} kW): puede haber recargo.`);
  if (f.cargos && f.cargos.length && previas.length) {
    const vistos = new Set(previas.flatMap(x => (x.cargos || []).map(c => normNom(c.concepto))));
    const nuevos = f.cargos.filter(c => !vistos.has(normNom(c.concepto)));
    if (nuevos.length) add('info', 'Cargos que no aparecían antes: ' + nuevos.map(c => `${c.concepto} (${pesos(c.monto)})`).join(', ') + '.');
    const pu = previas[previas.length - 1];
    (f.cargos || []).forEach(c => { const o = (pu.cargos || []).find(x => normNom(x.concepto) === normNom(c.concepto)); if (o && o.precio_unitario && c.precio_unitario && Math.abs(c.precio_unitario / o.precio_unitario - 1) > 0.05) add('info', `${c.concepto}: el precio unitario cambió de ${num(o.precio_unitario, 2)} a ${num(c.precio_unitario, 2)} (${pct((c.precio_unitario / o.precio_unitario - 1) * 100)}).`); });
  }
  if (s && desde && hasta && f.consumoKwh != null) {
    const p = consumoPropio(s.id, desde, hasta);
    if (!p) add('info', 'Aún no hay lecturas propias que cubran este período para compararlo con Copelec.');
    else { const dif = p.kwh - f.consumoKwh, v = f.consumoKwh ? dif / f.consumoKwh * 100 : null; add(Math.abs(v) > 5 ? 'warn' : 'ok', `Nuestro medidor: ${num(p.kwh)} kWh${p.aprox ? ' (aprox.: las lecturas no caen justo en las fechas del período)' : ''} vs ${num(f.consumoKwh)} kWh de Copelec: diferencia ${num(dif)} kWh (${pct(v)}).`); }
  }
  if (f.observaciones) add('info', 'Notas de la lectura: ' + f.observaciones);
  return out;
}
const nivelMax = ch => ch.some(c => c.nivel === 'err') ? 'err' : ch.some(c => c.nivel === 'warn') ? 'warn' : 'ok';
const chipNivel = ch => { const e = ch.filter(c => c.nivel === 'err').length, w = ch.filter(c => c.nivel === 'warn').length; return e ? `<span class="chip err">${e} error${e > 1 ? 'es' : ''}</span>` + (w ? `<span class="chip warn">${w} alerta${w > 1 ? 's' : ''}</span>` : '') : w ? `<span class="chip warn">${w} alerta${w > 1 ? 's' : ''}</span>` : '<span class="chip ok">✓ sin alertas</span>'; };
const checksHtml = ch => ch.map(c => `<div class="chk ${c.nivel}"><span>${{ ok: '✓', warn: '⚠️', err: '⛔', info: 'ℹ️' }[c.nivel]}</span><span>${escA(c.txt)}</span></div>`).join('');

// ── gráficos (SVG simple) ───────────────────────────────────────────────
function barras(labels, series, fmt, alto = 170) {
  const W = 640, H = alto, pl = 8, pb = 22, pt = 14, n = labels.length, g = (W - pl * 2) / Math.max(1, n), k = series.length, bw = Math.min(26, (g - 6) / k);
  const max = Math.max(1, ...series.flatMap(s => s.valores.map(v => v || 0)));
  let b = '';
  labels.forEach((l, i) => {
    series.forEach((s, j) => { const v = s.valores[i]; if (v == null) return; const h = (H - pb - pt) * v / max, x = pl + g * i + (g - bw * k) / 2 + bw * j; b += `<rect x="${x.toFixed(1)}" y="${(H - pb - h).toFixed(1)}" width="${(bw - 1).toFixed(1)}" height="${h.toFixed(1)}" rx="2" fill="${s.color}"><title>${escA(l)} · ${escA(s.nombre)}: ${escA(fmt(v))}</title></rect>`; if (k === 1 && n <= 14) b += `<text x="${(pl + g * i + g / 2).toFixed(1)}" y="${(H - pb - h - 3).toFixed(1)}" font-size="9" text-anchor="middle" fill="currentColor">${escA(fmt(v))}</text>`; });
    b += `<text x="${(pl + g * i + g / 2).toFixed(1)}" y="${H - 6}" font-size="10" text-anchor="middle" fill="currentColor" opacity=".7">${escA(l)}</text>`;
  });
  return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;color:var(--negro)" role="img">${b}<line x1="${pl}" x2="${W - pl}" y1="${H - pb}" y2="${H - pb}" stroke="currentColor" opacity=".25"/></svg>`;
}
const leyenda = series => '<div class="hint" style="margin:2px 0 6px">' + series.map(s => `<span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:${s.color};margin-right:4px"></span>${escA(s.nombre)}`).join(' &nbsp; ') + '</div>';

