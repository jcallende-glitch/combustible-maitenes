function rLecturas() {
  if (!S.sum.length) return '<div class="panel">Primero crea un suministro en ⚙️ Suministros.</div>';
  const sid = S.filtroSum && sumDe(S.filtroSum) ? S.filtroSum : S.sum[0].id; S.filtroSum = sid;
  const s = sumDe(sid), lecs = lecDe(sid), ul = lecs[lecs.length - 1];
  const sel = `<select id="l-sum" onchange="S_filtro(this.value)">${S.sum.map(x => `<option value="${x.id}" ${x.id === sid ? 'selected' : ''}>${escA(x.nombre)}</option>`).join('')}</select>`;
  const form = `<div class="panel"><h2>Anotar lectura del medidor</h2><div class="field"><label>Suministro</label>${sel}</div>
    <div class="hint">${ul ? `Última lectura: <b>${num(ul.lectura, 1)}</b> kWh el ${fCorta(ul.fecha)}.` : 'Aún no hay lecturas de este medidor.'} Medidor ${escA(s.medidor || '–')}${s.constante && s.constante !== 1 ? ' · constante ' + s.constante : ''}.</div>
    <div class="grid"><div class="field"><label>Fecha</label><input type="date" id="l-fecha" value="${hoyStr()}"></div><div class="field"><label>Lectura (kWh)</label><input type="number" id="l-val" step="any" inputmode="decimal" placeholder="Lo que marca el medidor"></div></div>
    <div class="field"><label>Observación (opcional)</label><input id="l-obs" placeholder="Ej: lectura de fin de mes"></div>
    <label style="font-size:13px;display:flex;gap:6px;align-items:center;margin:6px 0"><input type="checkbox" id="l-reinicio" style="width:auto"> El medidor se reinició o fue reemplazado</label>
    <button class="btn btn-verde btn-full" onclick="guardarLectura()">💾 Guardar lectura</button></div>`;
  const K = s.constante || 1;
  const filas = lecs.map((l, i) => { const a = lecs[i - 1], d = a ? dias(a.fecha, l.fecha) : null, k = a && !l.reinicio ? (l.lectura - a.lectura) * K : null; return { l, d, k }; }).reverse();
  const tabla = `<div class="panel"><h2>Lecturas de ${escA(s.nombre)}</h2>${filas.length ? `<div class="tw"><table><thead><tr><th>Fecha</th><th class="n">Lectura</th><th class="n">Días</th><th class="n">Consumo</th><th class="n">kWh/día</th><th></th></tr></thead><tbody>${filas.map(({ l, d, k }) => `<tr><td>${fCorta(l.fecha)}${l.reinicio ? ' <span class="chip info">reinicio</span>' : ''}${l.obs ? `<div class="hint">${escA(l.obs)}</div>` : ''}</td><td class="n">${num(l.lectura, 1)}</td><td class="n">${d != null ? num(d) : '–'}</td><td class="n">${k != null ? num(k) + ' kWh' : '–'}</td><td class="n">${k != null && d > 0 ? num(k / d, 1) : '–'}</td><td><button class="btn btn-rojo" style="padding:2px 8px" onclick="borrarLectura('${l.id}')">✕</button></td></tr>`).join('')}</tbody></table></div>` : '<div class="hint">Sin lecturas.</div>'}</div>`;
  const fs = facDe(sid).slice().reverse();
  const cmp = `<div class="panel"><h2>Nuestro medidor vs Copelec</h2>${fs.length ? `<div class="tw"><table><thead><tr><th>Período facturado</th><th class="n">Copelec</th><th class="n">Nuestro</th><th class="n">Diferencia</th></tr></thead><tbody>${fs.map(f => { const p = consumoPropio(sid, f.periodoDesde, f.periodoHasta); if (!p || f.consumoKwh == null) return `<tr><td>${fCorta(f.periodoDesde)} → ${fCorta(f.periodoHasta)}</td><td class="n">${num(f.consumoKwh)}</td><td class="n hint" colspan="2">sin lecturas que cubran el período</td></tr>`; const dif = p.kwh - f.consumoKwh, v = f.consumoKwh ? dif / f.consumoKwh * 100 : null; return `<tr><td>${fCorta(f.periodoDesde)} → ${fCorta(f.periodoHasta)}</td><td class="n">${num(f.consumoKwh)}</td><td class="n">${num(p.kwh)}${p.aprox ? ' ≈' : ''}</td><td class="n ${Math.abs(v) > 5 ? 'up' : 'down'}">${num(dif)} kWh (${pct(v)})</td></tr>`; }).join('')}</tbody></table></div><div class="hint" style="margin-top:6px">Las lecturas propias se llevan a las fechas del período de Copelec (entre dos lecturas se reparte por días). Mientras más cerca estén tus lecturas del inicio y fin de cada período, más exacta es la comparación. ≈ = aproximado.</div>` : '<div class="hint">Sube facturas para comparar.</div>'}</div>`;
  return form + tabla + cmp;
}
window.S_filtro = v => { S.filtroSum = v; render(); };
window.guardarLectura = async function () {
  const sid = $('l-sum').value, fecha = $('l-fecha').value, val = parseNum($('l-val').value), reinicio = $('l-reinicio').checked;
  if (!sid || !fecha || val == null) { toast('Completa la fecha y la lectura', false); return; }
  const lecs = lecDe(sid), ant = lecs.filter(l => l.fecha <= fecha).slice(-1)[0];
  if (ant && !reinicio && val < ant.lectura && !confirm(`La lectura (${num(val, 1)}) es menor que la anterior (${num(ant.lectura, 1)} el ${fCorta(ant.fecha)}). ¿Guardar igual?`)) return;
  if (ant && !reinicio && ant.fecha < fecha) { const d = dias(ant.fecha, fecha), s = sumDe(sid), prom = lecs.length > 2 ? (lecs[lecs.length - 1].lectura - lecs[0].lectura) / Math.max(1, dias(lecs[0].fecha, lecs[lecs.length - 1].fecha)) : null; if (prom && d > 0 && (val - ant.lectura) / d > prom * 3 && !confirm('El consumo por día de esta lectura es más de 3 veces el habitual. ¿Está bien la lectura?')) return; }
  try { await addDoc(collection(db, 'energia_lecturas'), { suministro: sid, fecha, lectura: val, obs: $('l-obs').value.trim(), reinicio, registrado_por: USER.nombre, ts: Date.now() }); await cargarTodo(); render(); toast('✓ Lectura guardada'); } catch (e) { toast('Error: ' + e.message, false); }
};
window.borrarLectura = async function (id) { if (!confirm('¿Borrar esta lectura?')) return; try { await deleteDoc(doc(db, 'energia_lecturas', id)); await cargarTodo(); render(); } catch (e) { toast('Error: ' + e.message, false); } };

// ── 📈 Comparar ──────────────────────────────────────────────────────────
window.S_cmp = (k, v) => { S.cmp[k] = v; render(); };
function rComparar() {
  if (!S.fac.length) return '<div class="panel">Sube facturas para poder comparar.</div>';
  const sid = S.cmp.sum, met = S.cmp.met;
  const base = sid ? S.fac.filter(f => f.suministro === sid) : S.fac;
  const valor = f => met === 'kwh' ? f.consumoKwh : met === 'total' ? f.total : precioKwh(f);
  const fmt = v => met === 'kwh' ? num(v) : met === 'total' ? pesos(v) : '$' + num(v, 1);
  const agg = (mes) => { const fs = base.filter(f => f.mes === mes); if (!fs.length) return null; if (met === 'precio') { const k = fs.reduce((a, f) => a + (f.consumoKwh || 0), 0), n = fs.reduce((a, f) => a + (f.neto || (f.total ? f.total / 1.19 : 0)), 0); return k > 0 ? n / k : null; } return fs.reduce((a, f) => a + (valor(f) || 0), 0); };
  const ult = base.map(f => f.mes).filter(Boolean).sort().slice(-1)[0], y = ult ? +ult.slice(0, 4) : new Date().getFullYear();
  const lab = MESES.map(m => m), v1 = MESES.map((_, i) => agg(`${y}-${String(i + 1).padStart(2, '0')}`)), v0 = MESES.map((_, i) => agg(`${y - 1}-${String(i + 1).padStart(2, '0')}`));
  const series = [{ nombre: String(y - 1), color: '#9CA3AF', valores: v0 }, { nombre: String(y), color: '#2D7D46', valores: v1 }];
  const t1 = v1.filter(x => x != null).reduce((a, b) => a + b, 0), idx = v1.map((x, i) => x != null && v0[i] != null ? i : -1).filter(i => i >= 0);
  const sumA = idx.reduce((a, i) => a + v1[i], 0), sumB = idx.reduce((a, i) => a + v0[i], 0);
  const resumen = idx.length ? `En los ${idx.length} meses con datos en ambos años: <b>${fmt(sumA)}</b> (${y}) vs <b>${fmt(sumB)}</b> (${y - 1}) → <b class="${sumA > sumB ? 'up' : 'down'}">${pct((sumA / sumB - 1) * 100)}</b>` : 'Aún no hay meses con datos en ambos años.';
  const ult12 = [...new Set(base.map(f => f.mes).filter(Boolean))].sort().slice(-13);
  const cont = `<div class="panel"><h2>Comparar</h2><div class="grid"><div class="field"><label>Suministro</label><select onchange="S_cmp('sum',this.value)"><option value="">Todos juntos</option>${S.sum.map(s => `<option value="${s.id}" ${s.id === sid ? 'selected' : ''}>${escA(s.nombre)}</option>`).join('')}</select></div><div class="field"><label>Qué comparar</label><select onchange="S_cmp('met',this.value)"><option value="kwh" ${met === 'kwh' ? 'selected' : ''}>Consumo (kWh)</option><option value="total" ${met === 'total' ? 'selected' : ''}>Total pagado ($)</option><option value="precio" ${met === 'precio' ? 'selected' : ''}>Precio medio ($/kWh)</option></select></div></div>
    <h2 style="margin-top:10px">Mismo mes, año contra año</h2>${leyenda(series)}${barras(lab, series, fmt, 190)}<div style="font-size:13px;margin-top:6px">${resumen}</div></div>
    <div class="panel"><h2>Mes contra mes (últimos 13)</h2>${barras(ult12.map(mesTxt), [{ nombre: 'Valor', color: '#F5A623', valores: ult12.map(agg) }], fmt, 170)}
    <div class="tw" style="margin-top:6px"><table><thead><tr><th>Mes</th><th class="n">Valor</th><th class="n">vs mes anterior</th><th class="n">vs mismo mes año anterior</th></tr></thead><tbody>${[...ult12].reverse().map(m => { const a = agg(m), p = agg(mesMas(m, -1)), q = agg(mesMas(m, -12)); return `<tr><td>${mesTxt(m)}</td><td class="n">${fmt(a)}</td><td class="n">${a != null && p ? pct((a / p - 1) * 100) : '–'}</td><td class="n">${a != null && q ? pct((a / q - 1) * 100) : '–'}</td></tr>`; }).join('')}</tbody></table></div></div>`;
  return cont;
}

// ── ⚙️ Suministros ───────────────────────────────────────────────────────
let editSum = null;
function rSuministros() {
  const f = editSum;
  const form = f ? `<div class="panel"><h2>${f.id ? 'Editar' : 'Nuevo'} suministro</h2>
    <div class="grid"><div class="field"><label>Nombre</label><input id="s-nombre" value="${escA(f.nombre || '')}" placeholder="Ej: Bomba pozo 1"></div><div class="field"><label>N° de cliente (Copelec)</label><input id="s-cli" value="${escA(f.nCliente || '')}"></div><div class="field"><label>N° de medidor</label><input id="s-med" value="${escA(f.medidor || '')}"></div><div class="field"><label>Tarifa</label><input id="s-tar" value="${escA(f.tarifa || '')}" placeholder="BT1, AT3…"></div><div class="field"><label>Constante del medidor</label><input id="s-const" type="number" step="any" value="${f.constante || 1}"></div><div class="field"><label>Uso / centro de costo</label><input id="s-centro" value="${escA(f.centro || '')}" placeholder="Riego, casa, bodega…"></div></div>
    <div class="field"><label>Dirección / notas</label><input id="s-dir" value="${escA(f.direccion || '')}"></div>
    <label style="font-size:13px;display:flex;gap:6px;align-items:center;margin:6px 0"><input type="checkbox" id="s-act" style="width:auto" ${f.activo !== false ? 'checked' : ''}> Suministro activo</label>
    <div style="display:flex;gap:8px"><button class="btn btn-secondary" style="flex:1;justify-content:center" onclick="editSumCancel()">Cancelar</button><button class="btn btn-verde" style="flex:1;justify-content:center" onclick="guardarSuministro()">💾 Guardar</button></div></div>` : `<button class="btn btn-verde" style="margin-bottom:10px" onclick="editSumNuevo()">＋ Nuevo suministro</button>`;
  const lista = `<div class="panel"><h2>Suministros</h2>${S.sum.length ? `<div class="tw"><table><thead><tr><th>Nombre</th><th>Cliente</th><th>Medidor</th><th>Tarifa</th><th class="n">Const.</th><th>Uso</th><th></th></tr></thead><tbody>${S.sum.map(s => `<tr><td>${escA(s.nombre)}${s.activo === false ? ' <span class="chip warn">inactivo</span>' : ''}</td><td>${escA(s.nCliente || '–')}</td><td>${escA(s.medidor || '–')}</td><td>${escA(s.tarifa || '–')}</td><td class="n">${num(s.constante || 1, 2)}</td><td>${escA(s.centro || '–')}</td><td style="white-space:nowrap"><button class="btn btn-secondary" onclick="editSumEditar('${s.id}')">✏️</button> <button class="btn btn-rojo" onclick="borrarSuministro('${s.id}')">✕</button></td></tr>`).join('')}</tbody></table></div>` : '<div class="hint">Aún no hay suministros.</div>'}</div>`;
  return form + lista;
}
window.editSumNuevo = () => { editSum = { activo: true, constante: 1 }; render(); };
window.editSumEditar = id => { editSum = { ...sumDe(id) }; render(); };
window.editSumCancel = () => { editSum = null; render(); };
window.guardarSuministro = async function () {
  const v = id => $(id).value.trim(), nombre = v('s-nombre'); if (!nombre) { toast('Falta el nombre', false); return; }
  const d = { nombre, nCliente: v('s-cli'), medidor: v('s-med'), tarifa: v('s-tar'), constante: parseNum($('s-const').value) || 1, centro: v('s-centro'), direccion: v('s-dir'), activo: $('s-act').checked };
  try { if (editSum.id) await updateDoc(doc(db, 'energia_suministros', editSum.id), d); else await addDoc(collection(db, 'energia_suministros'), { ...d, ts: Date.now() }); editSum = null; await cargarTodo(); render(); toast('✓ Suministro guardado'); } catch (e) { toast('Error: ' + e.message, false); }
};
window.borrarSuministro = async function (id) {
  const n = S.fac.filter(f => f.suministro === id).length + S.lec.filter(l => l.suministro === id).length;
  if (!confirm(n ? `Este suministro tiene ${n} facturas/lecturas. Se borrará solo el suministro (las facturas y lecturas quedarán sin asignar). ¿Continuar?` : '¿Borrar este suministro?')) return;
  try { await deleteDoc(doc(db, 'energia_suministros', id)); await cargarTodo(); render(); } catch (e) { toast('Error: ' + e.message, false); }
};

async function iniciar() {
  $('quien').textContent = USER.nombre;
  try { await cargarTodo(); } catch (e) { $('main').innerHTML = `<div class="panel" style="color:#B91C1C">No se pudieron cargar los datos: ${escA(e.message)}<br><span class="hint">Si dice "permission", hay que permitir las colecciones energia_suministros, energia_lecturas y energia_facturas en las reglas de Firestore.</span></div>`; return; }
  render();
}
window.S = S;
revisarAcceso();
</script>
