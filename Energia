// ── lectura con IA ───────────────────────────────────────────────────────
let pinIA = '';
function aDataUrl(file) {
  return new Promise((ok, no) => {
    if (file.type === 'application/pdf') { if (file.size > 4.5 * 1024 * 1024) { no(new Error(file.name + ' pesa demasiado (máx. 4,5 MB)')); return; } const r = new FileReader(); r.onload = () => ok(r.result); r.onerror = () => no(new Error('No se pudo leer ' + file.name)); r.readAsDataURL(file); return; }
    const img = new Image(), url = URL.createObjectURL(file);
    img.onload = () => { const k = Math.min(1, 1800 / Math.max(img.width, img.height)), c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k); c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); URL.revokeObjectURL(url); ok(c.toDataURL('image/jpeg', 0.85)); };
    img.onerror = () => { URL.revokeObjectURL(url); no(new Error('No se pudo abrir la imagen ' + file.name)); }; img.src = url;
  });
}
window.leerFactura = async function () {
  const files = [...($('fac-arch').files || [])], est = $('fac-est');
  if (!files.length) { est.textContent = 'Elige el PDF o las fotos de la factura.'; return; }
  if (files.length > 3) { est.textContent = 'Máximo 3 archivos.'; return; }
  if (!pinIA) { if (USER.pin) pinIA = USER.pin; else pinIA = (prompt('Ingresa tu PIN para usar la lectura con IA') || '').trim(); if (!pinIA) return; }
  $('fac-leer').disabled = true; est.textContent = '🤖 Leyendo la factura… (puede tardar hasta un minuto)';
  try {
    const documentos = []; for (const f of files) documentos.push(await aDataUrl(f));
    const resp = await fetch('/api/leer-documento', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ usuario: USER.nombre, pin: pinIA, modo: 'electricidad', documentos }) });
    if (resp.status === 401) { pinIA = ''; throw new Error('PIN no válido para la lectura con IA'); }
    const j = await resp.json().catch(() => ({}));
    if (!resp.ok || !j.factura) throw new Error(j.error || 'No se pudo leer la factura');
    const d = j.factura; if (d.legible === false) throw new Error('La factura no se ve con claridad. Prueba con una foto más nítida o el PDF.');
    const nc = normNom(d.numero_cliente || ''), s = S.sum.find(x => nc && normNom(x.nCliente) === nc) || S.sum.find(x => d.numero_medidor && normNom(x.medidor) === normNom(d.numero_medidor));
    S.form = { id: null, leido: d, porIA: true, suministro: s ? s.id : '', periodoDesde: d.periodo_desde || '', periodoHasta: d.periodo_hasta || '', numeroDoc: d.numero_documento || '', vencimiento: d.fecha_vencimiento || '', emision: d.fecha_emision || null, lecturaAnterior: d.lectura_anterior != null ? d.lectura_anterior : null, lecturaActual: d.lectura_actual != null ? d.lectura_actual : null, constante: d.constante_medidor != null ? d.constante_medidor : (s && s.constante) || 1, consumoKwh: d.consumo_kwh != null ? d.consumo_kwh : null, demandaMaxKw: d.demanda_maxima_kw != null ? d.demanda_maxima_kw : null, potenciaKw: d.potencia_conectada_kw != null ? d.potencia_conectada_kw : null, neto: d.neto != null ? d.neto : null, iva: d.iva != null ? d.iva : null, total: d.total != null ? d.total : null, cargos: d.cargos || [], historialLeido: d.historial || null, observaciones: d.observaciones || '', aviso: s ? 'Leída con IA. Revisa las cifras contra la boleta antes de guardar.' : 'Leída con IA. No encontré un suministro con el cliente ' + (d.numero_cliente || '?') + ': elígelo o créalo.' };
    S.form.mes = mesDe(S.form.periodoHasta || S.form.emision);
    render(); $('form-fac') && $('form-fac').scrollIntoView({ behavior: 'smooth' });
  } catch (e) { est.innerHTML = '<span style="color:#B91C1C">' + escA(e.message) + '</span>'; const b = $('fac-leer'); if (b) b.disabled = false; }
};

