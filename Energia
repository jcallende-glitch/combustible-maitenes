// ── 📊 Resumen ───────────────────────────────────────────────────────────
function rResumen() {
  if (!S.sum.length) return `<div class="panel"><h2>Bienvenido</h2><p>Primero crea tus <b>suministros</b> (cada cuenta de Copelec: bombas, casa, bodega…) o sube una factura y la app los crea con los datos de la boleta.</p><button class="btn btn-verde" onclick="setTab('suministros')">⚙️ Crear suministros</button> <button class="btn btn-secondary" onclick="setTab('facturas')">📄 Subir una factura</button></div>`;
  const hoy = hoyStr();
